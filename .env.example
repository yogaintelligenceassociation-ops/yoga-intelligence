# ──────────────────────────────────────────────────────────────────────────────
# Yoga Intelligence — environment variables
# Copy this file to `.env` for local development.
# Set these in the Vercel dashboard for production.
# Never commit `.env` to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Backend (Python serverless, /api/*) ──────────────────────────────────

# NO DATABASE REQUIRED. The app is fully stateless:
#   • phone OTP is handled by Firebase Phone Authentication
#   • the login session is a JWT in the browser
#   • new sign-ups (name + phone) are sent only to your Google Sheet
#   • YoYogi chats are ephemeral and never stored

# Firebase project id (the `projectId` field from your Firebase web config).
# The backend uses it to validate Firebase ID tokens. REQUIRED for login.
FIREBASE_PROJECT_ID=

# Google Gemini API key (free tier works for Gemini 2.5 Flash).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Long, random string used to sign session JWTs. REQUIRED in production.
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=

# OPTIONAL — Google Sheet logging of new sign-ups (name + phone only).
# Create a Google Apps Script Web App bound to a Sheet (see README) and paste
# its /exec URL here. Leave blank to disable. Failures never block login.
GOOGLE_SHEET_WEBHOOK_URL=

# Comma-separated allow-list of origins. Use "*" only in development.
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# ─── Frontend (Create React App, REACT_APP_* are inlined at build time) ───

# Firebase WEB config (PUBLIC — safe to expose; secured by Authorized Domains).
# Copy these from Firebase Console → Project settings → Your apps → SDK config.
# These can ALSO be hard-coded directly in src/lib/firebase.js instead.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Base URL for API calls. Leave blank to use a relative `/api` path (works on
# Vercel because the frontend and serverless functions share the same domain).
REACT_APP_API_BASE_URL=

# Local dev only — used by Craco's dev-server proxy so /api/* hits your local
# uvicorn server instead of crashing.
API_PROXY_TARGET=http://localhost:8000
